# API — Android emulator uses 10.0.2.2 to reach the host machine.
# Physical phone: http://YOUR_LAN_IP:8011/api/v1
# Production builds: https://api.niveshguide.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8011/api/v1

# Google AdMob test banner (replace after Play Store listing)
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111

# Native AdMob only in custom/EAS builds — leave false for Expo Go
EXPO_PUBLIC_USE_NATIVE_ADMOB=false
