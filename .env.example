# Drive-hosted Google Spreadsheet. No Google Cloud.
# Share: Anyone with the link → Viewer
GOOGLE_SPREADSHEET_ID=1xzT_B1vlCr_MlYN6a-CVfxDUbB8BhZiqfQUJkPGPBBk
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_NAME=StockFilter
GOOGLE_SHEETS_CSV_URL=

DATABASE_URL=sqlite:///./data/screener.db
# Local web (Next on :3000) + Vite legacy (:5173). Production (Railway):
# CORS_ORIGINS=https://niveshguide.com,https://www.niveshguide.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
BATCH_SIZE=500
# Keep the API process running for unattended jobs (python -m cli serve).
# Sheet sync needs a valid Google OAuth token (python -m cli google-login when expired).
# On Railway: enable scheduler for indices + calculate; mount Google credentials
# only if you need sheet sync in the cloud.
SCHEDULER_ENABLED=false
SCHEDULER_SHEET_SYNC_MINUTES=15
SCHEDULER_SCREENER_ENABLED=true
SCHEDULER_SCREENER_MAX_PER_DAY=400
TIMEZONE=Asia/Kolkata

# AI Search (POST /api/v1/ai/query). Keep disabled until a provider key is set.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_MAX_ROWS=50
AI_TIMEOUT_SECONDS=20
